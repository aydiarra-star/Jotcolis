# Exemple de noms de variables SERVEUR uniquement. Aucune valeur réelle ici.
# Ne jamais committer de secret. Le navigateur ne doit recevoir que la clé publishable.

# Supabase (injectées automatiquement dans les Edge Functions ; ne pas les mettre dans le frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker de notifications : secret d'appel, à générer hors dépôt
NOTIFICATION_WORKER_SECRET=

# Prestataire e-mail : à choisir après validation contractuelle, RGPD et coûts
NOTIFICATION_EMAIL_ENDPOINT=
NOTIFICATION_EMAIL_TOKEN=

# WhatsApp Cloud API officielle Meta, template approuvé, compte autorisé
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=

# Aucune variable de test d'envoi automatique : le worker ne déclenche aucun
# appel prestataire tant que le canal n'est pas déclaré, testé puis activé
# explicitement côté serveur. Aucun abonnement ni service payant n'est requis ici.
